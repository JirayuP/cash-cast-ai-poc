# ==========================================
# LINE Messaging API Configuration
# ==========================================
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# ==========================================
# Google Gemini API Configuration
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# ==========================================
# Python & Tesseract OCR Configuration
# ==========================================
# คำสั่งเรียก Python (เช่น python หรือ python3 หรือ path ไปยัง venv)
PYTHON_PATH=python

# Path ของไฟล์ tesseract.exe (สำหรับ Windows หากไม่ได้อยู่ใน PATH)
# ตัวอย่าง: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ==========================================
# Server & Optional LIFF Config
# ==========================================
PORT=5000
LIFF_URL=https://liff.line.me/your-liff-id
